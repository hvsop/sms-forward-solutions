{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "private-sms",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "INBOX",
        "class_name": "Inbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Inbox"
      ]
    }
  ],
  "vars": {
    "APNS_TOPIC": "com.example.privatesms",
    "APNS_ENVIRONMENT": "production"
  },
  "assets": {
    "directory": "./public"
  }
}
